{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": ["dependency"],
  "packageRules": [
    {
      "matchDatasources": [
        "crate"
      ],
      "dependencyDashboardApproval": false,
      "rangeStrategy": "bump",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchPackageNames": [
        "quay.io/buildah/stable",
        "registry.hub.docker.com/commitlint/commitlint",
        "sonarsource/sonar-scanner-cli"
      ],
      "pinDigests": false
    }
  ]
}
